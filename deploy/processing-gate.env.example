# Han deployment input example.
# This is an intentionally empty template. It does not mirror or carry values
# approved in any deployment scope, including the 2026-10-22 local-dev User
# scope. Do not commit populated copies, credentials, or deployment values.

# LoadDeploymentConfig reads and validates all ten non-secret keys below.
# han-server runs that validation before database connection, migration, or
# listening. Required empty values fail startup; the optional CA path remains
# empty to select system trust roots.

# Required ProcessingGate references.
HAN_PROCESSING_REGION_REF=
HAN_PROCESSING_CONTROLLER_REF=
HAN_PROCESSING_LEGAL_BASIS_REF=
HAN_SMTP_PROCESSOR_REF=

# Required canonical origin and trusted proxy networks. Reading these values
# does not implement Origin middleware or trust forwarded proxy headers.
HAN_PUBLIC_ORIGIN=
HAN_TRUSTED_PROXY_CIDRS=

# SMTP TLS mode, host, and ServerName are required; the CA bundle path is
# optional. Reading them does not implement a mailer, SMTP connection, or send.
HAN_SMTP_TLS_MODE=
HAN_SMTP_HOST=
HAN_SMTP_SERVER_NAME=
HAN_SMTP_CA_BUNDLE=
